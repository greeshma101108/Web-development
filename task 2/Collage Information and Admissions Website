
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>ABC College Website</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
            scroll-behavior: smooth;
        }

        body {
            background: #f4f7fb;
            color: #222;
        }

        /* Navigation Bar */
        nav {
            background: #102c57;
            padding: 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        nav h2 {
            color: white;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 18px;
            flex-wrap: wrap;
        }

        nav ul li a {
            color: white;
            text-decoration: none;
            font-size: 14px;
        }

        nav ul li a:hover {
            color: #ffc857;
        }

        /* Banner */
        .banner {
            background: linear-gradient(
                120deg, #102c57, #2878a5
            );
            color: white;
            text-align: center;
            padding: 100px 20px;
        }

        .banner h1 {
            font-size: 42px;
            margin-bottom: 15px;
        }

        .banner p {
            font-size: 18px;
        }

        .btn {
            display: inline-block;
            margin-top: 25px;
            padding: 12px 25px;
            background: #ffc857;
            color: #102c57;
            text-decoration: none;
            border-radius: 5px;
            font-weight: bold;
        }

        /* Sections */
        section {
            padding: 55px 8%;
            text-align: center;
        }

        section h2 {
            color: #102c57;
            margin-bottom: 25px;
        }

        /* Cards */
        .container {
            display: grid;
            grid-template-columns:
                repeat(auto-fit, minmax(220px, 1fr));
            gap: 22px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 3px 12px
                        rgba(0,0,0,0.10);
        }

        .card h3 {
            color: #2878a5;
            margin-bottom: 12px;
        }

        .card p {
            line-height: 1.6;
        }

        /* Admissions */
        #admissions {
            background: #e7eff8;
        }

        /* Contact */
        #contact {
            background: #102c57;
            color: white;
        }

        #contact h2 {
            color: white;
        }

        footer {
            background: #071a35;
            color: white;
            text-align: center;
            padding: 18px;
        }

        /* Mobile Responsive */
        @media(max-width: 768px) {
            nav {
                flex-direction: column;
                gap: 15px;
            }

            nav ul {
                justify-content: center;
            }

            .banner h1 {
                font-size: 30px;
            }

            section {
                padding: 40px 5%;
            }
        }
    </style>
</head>

<body>

