
<!DOCTYPE html>
<html>
<head>
    <title>Healthy Food and Nutrition</title>

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background-color: #f4fff4;
            color: #333;
        }

        /* Navigation Bar */
        nav {
            background: #176b3a;
            padding: 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        nav h2 {
            color: white;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 15px;
            flex-wrap: wrap;
        }

        nav a {
            color: white;
            text-decoration: none;
        }

        /* Banner */
        .banner {
            background: linear-gradient(
                to right, #176b3a, #78bd78
            );
            text-align: center;
            color: white;
            padding: 80px 20px;
        }

        .banner h1 {
            font-size: 40px;
            margin-bottom: 15px;
        }

        .banner p {
            font-size: 18px;
        }

        .btn {
            display: inline-block;
            background: #ffdf80;
            color: #176b3a;
            padding: 12px 22px;
            margin-top: 20px;
            text-decoration: none;
            border-radius: 5px;
        }

        /* Sections */
        section {
            padding: 45px 7%;
            text-align: center;
        }

        section h2 {
            color: #176b3a;
            margin-bottom: 25px;
        }

        /* Responsive Cards */
        .container {
            display: grid;
            grid-template-columns:
                repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 3px 10px
                rgba(0,0,0,0.1);
        }

        .card h3 {
            color: #23864b;
            margin: 12px 0;
        }

        .emoji {
            font-size: 40px;
        }

        .card p {
            line-height: 1.6;
        }

        /* Recipe Buttons */
        button {
            background: #176b3a;
            color: white;
            border: none;
            padding: 10px 15px;
            border-radius: 5px;
            cursor: pointer;
            margin-top: 12px;
        }

        button:hover {
            background: #23864b;
        }

        .ingredients {
            display: none;
            margin-top: 15px;
            background: #e5f5e7;
            padding: 12px;
            text-align: left;
            border-radius: 5px;
        }

        #meal {
            background: #e5f5e7;
        }

        #contact {
            background: #176b3a;
            color: white;
        }

        #contact h2 {
            color: white;
        }

        footer {
            background: #104c29;
            color: white;
            text-align: center;
            padding: 18px;
        }

        /* Mobile Design */
        @media(max-width: 768px) {
            nav {
                flex-direction: column;
                gap: 15px;
            }

            nav ul {
                justify-content: center;
            }

            .banner h1 {
                font-size: 28px;
            }
        }
    </style>
</head>

<body>

<!-- Navigation -->
<nav>
    <h2>Healthy Life</h2>

    <ul>
        <li><a href="#home">Home</a></li>
        <li><a href="#categories">Categories</a></li>
        <li><a href="#recipes">Recipes</a></li>
        <li><a href="#meal">Meal Plans</a></li>
        <li><a href="#tips">Tips</a></li>
        <li><a href="#contact">Contact</a></li>
    </ul>
</nav>

<!-- Home Banner -->
<header class="banner" id="home">
    <h1>Healthy Food and Nutrition</h1>
    <p>Eat Healthy, Stay Healthy and Live Better!</p>
    <a href="#recipes" class="btn">Explore Recipes</a>
</header>

<!-- Food Categories -->
<section id="categories">
    <h2>Food Categories</h2>

    <div class="container">

        <div class="card">
            <div class="emoji">🍎</div>
            <h3>Fruits</h3>
            <p>Apples, bananas, oranges and grapes.</p>
        </div>

        <div class="card">
            <div class="emoji">🥦</div>
            <h3>Vegetables</h3>
            <p>Carrots, spinach, broccoli and tomatoes.</p>
        </div>

        <div class="card">
            <div class="emoji">🌾</div>
            <h3>Whole Grains</h3>
            <p>Rice, oats, wheat and millets.</p>
        </div>

        <div class="card">
            <div class="emoji">🥜</div>
            <h3>Protein Foods</h3>
            <p>Dal, beans, eggs and nuts.</p>
        </div>

    </div>
</section>

<!-- Recipes -->
<section id="recipes">
    <h2>Nutritious Recipes</h2>

    <div class="container">

        <div class="card">
            <div class="emoji">🥗</div>
            <h3>Vegetable Salad</h3>
            <p>Calories: Approximately 150 kcal</p>

            <button onclick="showRecipe('salad')">
                View Ingredients
            </button>

            <div class="ingredients" id="salad">
                <b>Ingredients:</b>
                <p>Cucumber, tomato, carrot,
                   lemon juice and pepper.</p>
            </div>
        </div>

        <div class="card">
            <div class="emoji">🥣</div>
            <h3>Healthy Oats</h3>
            <p>Calories: Approximately 250 kcal</p>

            <button onclick="showRecipe('oats')">
                View Ingredients
            </button>

            <div class="ingredients" id="oats">
                <b>Ingredients:</b>
                <p>Oats, milk, banana and almonds.</p>
            </div>
        </div>

        <div class="card">
            <div class="emoji">🍲</div>
            <h3>Vegetable Soup</h3>
            <p>Calories: Approximately 120 kcal</p>

            <button onclick="showRecipe('soup')">
                View Ingredients
            </button>

            <div class="ingredients" id="soup">
                <b>Ingredients:</b>
                <p>Carrot, beans, tomato, water
                   and black pepper.</p>
            </div>
        </div>

    </div>
</section>

<!-- Meal Plans -->
<section id="meal">
    <h2>Daily Meal Plans</h2>

    <div class="container">

        <div class="card">
            <div class="emoji">🌅</div>
            <h3>Breakfast</h3>
            <p>Idli, sambar and seasonal fruit.</p>
        </div>

        <div class="card">
            <div class="emoji">☀️</div>
            <h3>Lunch</h3>
            <p>Rice, dal, vegetables and curd.</p>
        </div>

        <div class="card">
            <div class="emoji">🍌</div>
            <h3>Evening Snack</h3>
            <p>Fruit or roasted chana.</p>
        </div>

        <div class="card">
            <div class="emoji">🌙</div>
            <h3>Dinner</h3>
            <p>Roti, vegetable curry and dal.</p>
        </div>

    </div>
</section>

<!-- Healthy Tips -->
<section id="tips">
    <h2>Healthy Eating Tips</h2>

    <div class="container">

        <div class="card">
            <h3>Drink Water</h3>
            <p>Drink water regularly.</p>
        </div>

        <div class="card">
            <h3>Eat Fruits</h3>
            <p>Include seasonal fruits in meals.</p>
        </div>

        <div class="card">
            <h3>Balanced Diet</h3>
            <p>Include different food groups.</p>
        </div>

        <div class="card">
            <h3>Stay Active</h3>
            <p>Include regular physical activity.</p>
        </div>

    </div>
</section>

<!-- Contact -->
<section id="contact">
    <h2>Contact Us</h2>
    <p>Email: healthylife@example.com</p>
    <p>Phone: +91 9876543210</p>
    <p>Location: Andhra Pradesh, India</p>
</section>

<footer>
    <p>© 2026 Healthy Life. All Rights Reserved.</p>
</footer>

<!-- JavaScript -->
<script>
    function showRecipe(id) {

        let recipe =
            document.getElementById(id);

        if (recipe.style.display === "block") {
            recipe.style.display = "none";
        } else {
            recipe.style.display = "block";
        }
    }

    console.log("Healthy Food Website Loaded");
</script>

</body>
</html>

