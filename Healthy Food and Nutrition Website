
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Healthy Food and Nutrition</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
            scroll-behavior: smooth;
        }

        body {
            background: #f5fff5;
            color: #333;
        }

        /* Navigation */
        nav {
            background: #226b3b;
            padding: 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        nav h2 {
            color: white;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 18px;
            flex-wrap: wrap;
        }

        nav ul li a {
            color: white;
            text-decoration: none;
        }

        nav ul li a:hover {
            color: #ffe082;
        }

        /* Banner */
        .banner {
            background: linear-gradient(
                120deg, #226b3b, #78b96e
            );
            color: white;
            text-align: center;
            padding: 100px 20px;
        }

        .banner h1 {
            font-size: 42px;
            margin-bottom: 15px;
        }

        .banner p {
            font-size: 18px;
        }

        .btn {
            display: inline-block;
            margin-top: 25px;
            padding: 12px 25px;
            background: #ffe082;
            color: #225b32;
            text-decoration: none;
            border-radius: 5px;
            font-weight: bold;
        }

        /* Sections */
        section {
            padding: 55px 8%;
            text-align: center;
        }

        section h2 {
            color: #226b3b;
            margin-bottom: 25px;
        }

        /* Responsive Cards */
        .container {
            display: grid;
            grid-template-columns:
                repeat(auto-fit, minmax(220px, 1fr));
            gap: 22px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 3px 12px
                rgba(0,0,0,0.10);
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-5px);
        }

        .card h3 {
            color: #32834a;
            margin-bottom: 12px;
        }

        .card p {
            line-height: 1.6;
        }

        .emoji {
            font-size: 40px;
            margin-bottom: 12px;
        }

        #meal {
            background: #e8f5e9;
        }

        #contact {
            background: #226b3b;
            color: white;
        }

        #contact h2 {
            color: white;
        }

        footer {
            background: #164b2b;
            color: white;
            text-align: center;
            padding: 18px;
        }

        /* Responsive Design */
        @media(max-width: 768px) {
            nav {
                flex-direction: column;
                gap: 15px;
            }

            nav ul {
                justify-content: center;
            }

            .banner h1 {
                font-size: 30px;
            }

            section {
                padding: 40px 5%;
            }
        }
    </style>
</head>

